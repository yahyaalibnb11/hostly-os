# Hostly OS — its own Supabase project (never the Ember OS one). Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Claude powers the agents; without it they fall back to rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Any long random text. Vercel Cron sends it automatically; Supabase pg_cron sends it as a Bearer token.
CRON_SECRET=
# Shared secret your PMS/channel signs webhooks with (header x-hostly-signature: sha256=<hex HMAC>).
HOSTLY_WEBHOOK_SECRET=

# Optional: WhatsApp Cloud API for Concierge replies (a Hostly number, not the Ember OS one).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0
